# Unignore specific files
!README.MD
!.gitignore

# Explicitly ignore these (redundant due to * but good for clarity/overrides if I change * later)
config.py
logs/
tests/
/pytest.ini
docs/
results.md
AGENTS.md
.agents/
tmp/
custom_extensions/
/custom_web/
/web_runtime/
**/__pycache__/
.vscode

# Frontend sources and the reviewed base bundle are product files; local builds are not.
node_modules/
/web/dist/
*.tsbuildinfo
/web/prebuilt/*
!/web/prebuilt/base-ui.zip

# База данных (создаётся автоматически при запуске)
database/vpn_bot.db
database/vpn_bot.db-wal
database/vpn_bot.db-shm

# Локальные бэкапы (создаются автоматически планировщиком)
backup/

# Virtual Environment
venv/
env/
.venv/
.env/
env*/
venv*/
.env
