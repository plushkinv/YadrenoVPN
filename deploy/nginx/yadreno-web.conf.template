server {
@HTTP_LISTEN@
    server_name @DOMAIN@;
    location ^~ /.well-known/acme-challenge/ {
        root @ACME_ROOT@;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 @PUBLIC_URL@$request_uri; }
}
server {
@HTTPS_LISTEN@
    server_name @DOMAIN@;
    ssl_certificate @CERT_ROOT@/fullchain.pem;
    ssl_certificate_key @CERT_ROOT@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    proxy_hide_header X-Yadreno-Web-Config;
@CONFIG_HEADER@
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_redirect off;
    proxy_buffering off;
    # Five 10 MiB attachments (including voice) plus 64 KiB multipart metadata.
    location = /api/v1/admin/ui/editor/uploads {
        client_max_body_size 51264k;
        proxy_pass @UPSTREAM@;
    }
    # Python serves only verified publication inventory; no private tree is a document root.
    location / { proxy_pass @UPSTREAM@; }
}
